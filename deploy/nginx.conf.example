# ---------------------------------------------------------------------------
# Convoro — production nginx server block (example)
#
# Copy to /etc/nginx/sites-available/<your-domain>, edit the two CHANGE-ME
# spots (server_name + TLS cert paths), symlink into sites-enabled, then:
#     nginx -t && systemctl reload nginx
#
# The cache-control rules below are NOT optional polish — they prevent the
# single most common "the site won't load for returning visitors" bug:
#   * sw.js (the service worker) MUST be no-cache, or browsers HTTP-cache the
#     worker script and never pick up new deploys — a stale worker then keeps
#     serving a dead cached shell. This is the #1 PWA footgun.
#   * /build/ assets are content-hashed by Vite, so they are safe (and should)
#     be cached forever as immutable.
#   * The HTML shell is served no-cache by the app itself.
# ---------------------------------------------------------------------------

server {
    server_name CHANGE-ME.example.com;          # CHANGE-ME: your domain
    root /var/www/convoro/public;
    index index.php;
    charset utf-8;
    client_max_body_size 20M;

    # gzip text assets (brotli is even better if your nginx has the module).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # Service worker: never HTTP-cache it, or SW updates can't propagate.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Content-hashed build assets are immutable — cache them hard.
    location /build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /favicon.ico { access_log off; log_not_found off; }
    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php-fpm.sock;  # match your PHP-FPM socket
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny dotfiles except ACME challenges.
    location ~ /\.(?!well-known).* { deny all; }

    # --- TLS (certbot fills these in; CHANGE-ME to your domain) ---
    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate     /etc/letsencrypt/live/CHANGE-ME.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CHANGE-ME.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = CHANGE-ME.example.com) { return 301 https://$host$request_uri; }
    listen 80;
    listen [::]:80;
    server_name CHANGE-ME.example.com;
    return 404;
}
