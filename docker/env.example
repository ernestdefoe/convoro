# Convoro — Docker Compose environment.
# Copy to .env, then generate APP_KEY:
#   docker compose run --rm app php artisan key:generate --show
# and paste the value below.

APP_NAME=Convoro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_PORT=8080
REVERB_PORT=8081

# Database (the bundled MySQL service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=convoro
DB_USERNAME=convoro
DB_PASSWORD=convoro
DB_ROOT_PASSWORD=convoro_root

# Cache / queue / sessions on the bundled Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Realtime (Reverb). Set these to your own values in production.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=convoro
REVERB_APP_KEY=convoro-key
REVERB_APP_SECRET=convoro-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Mail — log driver by default; switch to smtp/sendmail for real delivery.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Convoro
