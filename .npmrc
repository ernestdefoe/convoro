ignore-scripts=true
audit=true
# @tiptap/extension-code-block-lowlight declares a strict exact-version peer on
# @tiptap/core that npm's strict resolver can't satisfy alongside the rest of the
# TipTap suite. Auto-accept the (working) resolution so npm install / npm ci
# succeed everywhere — local, Docker, prod, CI — without a manual flag.
legacy-peer-deps=true
